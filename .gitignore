# ==========================================
# Unreal Engine project .gitignore
# These folders are generated by the engine and should not be committed
# (Saved / Intermediate / DerivedDataCache are the main source of the "files too large" warnings)
# ==========================================

# Engine-generated / cache folders
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/*
!Build/*/
Build/*/**
!Build/**/*.ico

# Plugin build output (keep plugin source and Content)
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.vcxproj*
*.xcodeproj
*.xcworkspace

# Compiled files
*.pdb
*.dll
*.exe
*.o
*.lib
*.a
*.so
*.dylib
*.ipa
*.apk
*.target
*.modules

# Packaged builds
Releases/
Packaged/
*.pak

# System files
Thumbs.db
Desktop.ini
.DS_Store

# ==========================================
# 5.7 version: large unused Fab pack (13.6 GB VDB clouds, not used by any level).
# Kept locally and in the zip backup; re-add from Fab if needed.
# ==========================================
Content/Clouds_Tunnel_Loop/
